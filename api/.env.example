APP_NAME=Marketplace
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
FRONTEND_URL=http://localhost:5173

# Sanctum SPA cookie mode: origins here get session-cookie auth; every other
# origin (mobile, Postman, server-to-server) falls back to bearer tokens.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database — PostGIS required, see docker-compose.yml at the repo root
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=marketplace
DB_USERNAME=marketplace
DB_PASSWORD=marketplace

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Redis — separate logical DBs so a cache eviction never eats queued jobs or sessions
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CACHE_DB=0
REDIS_QUEUE_DB=1
REDIS_SESSION_DB=2

# Mail — Mailpit locally via SMTP; staging/production send through the
# Gmail API mailer instead (never SMTP, never a third-party ESP — CLAUDE.md
# stack table). Swap MAIL_MAILER to "gmail" and fill in the GMAIL_* creds
# below for staging/production.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@marketplace.local"
MAIL_FROM_NAME="${APP_NAME}"

# Gmail API (OAuth2) mailer — staging/production only, see config/mail.php
# "gmail" mailer + App\Support\Mail\GmailApiTransport.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

# Web push (VAPID) — browser Push API delivery for in-app notification
# preferences that have push_web enabled.
VAPID_SUBJECT="mailto:support@marketplace.local"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Storage — MinIO locally (S3-compatible), see docker-compose.yml at the repo root
AWS_ACCESS_KEY_ID=marketplace
AWS_SECRET_ACCESS_KEY=marketplace-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=marketplace-local
AWS_ENDPOINT=http://localhost:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Geocoding — Geoapify, Canada-filtered at the provider level (CLAUDE.md §5)
GEOAPIFY_API_KEY=

# Stripe Connect — CA/CAD only, no country selection (CLAUDE.md §5/§7)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_REFRESH_URL=
STRIPE_CONNECT_RETURN_URL=

VITE_APP_NAME="${APP_NAME}"
