VITE_API_BASE_URL=http://localhost:8000

# Leaflet/OSM tiles served via MapTiler or Stadia — never raw tile.openstreetmap.org (CLAUDE.md §2).
VITE_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=__MAPTILER_KEY__
VITE_MAP_TILE_ATTRIBUTION=© MapTiler © OpenStreetMap contributors
VITE_MAPTILER_API_KEY=

# One-time address geocoding on form submit, Canada-filtered (CLAUDE.md §5).
VITE_GEOAPIFY_API_KEY=
VITE_GEOAPIFY_BASE_URL=https://api.geoapify.com/v1/geocode/search

# Stripe Connect (Payment Element). Publishable key is safe to expose client-side;
# amounts/fees are always recomputed server-side (CLAUDE.md §2/§5).
VITE_STRIPE_PUBLISHABLE_KEY=
