# Credentials for the local docker-compose stack (docker-compose.yml).
# Copy this file to `.env` in the repo root before running `make up` / `docker compose up -d`.
# This is separate from api/.env and web/.env, which configure the Laravel and React apps
# once they're scaffolded (see docs/PROJECT_SETUP.md §3) — those reference these same
# values to reach the containers below.

# --- Postgres (postgis/postgis:16-3.4) ---
DB_PORT=5432
DB_DATABASE=marketplace
DB_USERNAME=marketplace
DB_PASSWORD=marketplace

# --- Redis (redis:7-alpine) ---
# Logical DB split, applied by the Laravel app, not by the container:
# 0 = cache, 1 = queue, 2 = session
REDIS_PORT=6379

# --- MinIO (S3-compatible storage) ---
MINIO_ROOT_USER=marketplace
MINIO_ROOT_PASSWORD=marketplace-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=marketplace-local

# --- Mailpit (local SMTP catcher) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
